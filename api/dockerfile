FROM python:3.12-slim

WORKDIR /api

# 1. Instala dependências de compilação + curl (para o healthcheck) em uma única camada
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    build-essential \
    libpq-dev \
    libcurl4-openssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Copia e instala as dependências Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 3. Cria o usuário de segurança não-root
RUN groupadd -r appuser && useradd -r -g appuser appuser

# 4. Copia os arquivos da aplicação definindo a posse para o appuser
COPY --chown=appuser:appuser . .

# 5. Alterna para o usuário seguro
USER appuser

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]